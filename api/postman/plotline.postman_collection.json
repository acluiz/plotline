        {
          "name": "List books",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const books = pm.response.json();",
                  "",
                  "pm.test('Returns an array', () => pm.expect(books).to.be.an('array'));",
                  "",
                  "pm.test('Each book has the expected fields', () => {",
                  "  books.forEach((book) => {",
                  "    pm.expect(book).to.have.all.keys('id', 'title', 'author', 'pages', 'genre', 'status', 'createdAt', 'updatedAt');",
                  "    pm.expect(book.status).to.be.oneOf(['WANT_TO_READ', 'READING', 'READ']);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
