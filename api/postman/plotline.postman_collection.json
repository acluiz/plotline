              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const book = pm.response.json();",
                  "",
                  "pm.test('Returns the updated book', () => {",
                  "  pm.expect(book.id).to.eql(pm.collectionVariables.get('bookId'));",
                  "  pm.expect(book.title).to.eql(\"Clean Architecture: A Craftsman's Guide\");",
                  "  pm.expect(book.pages).to.eql(450);",
                  "  pm.expect(book.genre).to.eql('Software Engineering');",
