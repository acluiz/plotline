      "item": [
        {
          "name": "Create book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const book = pm.response.json();",
                  "",
                  "pm.test('Returns the created book with WANT_TO_READ status', () => {",
                  "  pm.expect(book.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "  pm.expect(book.title).to.eql('Clean Architecture');",
                  "  pm.expect(book.author).to.eql('Robert C. Martin');",
                  "  pm.expect(book.status).to.eql('WANT_TO_READ');",
                  "  pm.expect(book.createdAt).to.be.a('string');",
                  "  pm.expect(book.updatedAt).to.be.a('string');",
                  "});",
                  "",
                  "// Reused by the next requests (get, update, delete...)",
                  "pm.collectionVariables.set('bookId', book.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Architecture\",\n  \"author\": \"Robert C. Martin\",\n  \"pages\": 432,\n  \"genre\": \"Technology\"\n}",
              "options": {
