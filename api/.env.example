# Server
PORT=3000

# Supabase PostgreSQL connection string (use the Session pooler URI).
# Format: postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Supabase requires SSL. Set to "false" only for a local PostgreSQL without SSL.
DATABASE_SSL=true

# Database schema used by the application and migrations (defaults to "public").
DATABASE_SCHEMA=public
